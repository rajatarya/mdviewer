{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "shell:allow-open",
    "opener:default"
  ],
  "capabilities": [
    {
      "identifier": "shell-open",
      "description": "Allow opening files",
      "permissions": [
        "shell:allow-open"
      ]
    }
  ]
}
